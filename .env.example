# Optional: backend-only GitHub token for public repositories.
GITHUB_TOKEN=
# Optional corporate GitLab: operator-approved canonical HTTPS installation URL.
# Example: https://gitlab.company.example (not /api/v4, not a project URL).
# Keep blank to disable GitLab. Only this configured instance is accepted.
GITLAB_BASE_URL=
# Server-only, least-privilege token with read_api and intended project access.
# Never put tokens in source, URLs, logs, VITE_* variables or browser storage.
# Use a restricted local .env; do not commit or share it or rendered Compose config.
GITLAB_TOKEN=
# Frontend published only on loopback; backend has no published port.
REPO_XRAY_PORT=8080
